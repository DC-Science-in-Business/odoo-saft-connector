# ---------------------------------------------------------------------------
# Model: res.config.settings (SAF-T extension)
# ---------------------------------------------------------------------------

#. model_terms: res.config.settings / field:saft_api_url / string
msgid "URL da API SAF-T"
msgstr "SAF-T API URL"

#. model_terms: res.config.settings / field:saft_api_url / help
msgid "Endereço do servidor da API SAF-T (ex: https://api.saft.sciencebusiness.pt)"
msgstr "SAF-T API server address (e.g. https://api.saft.sciencebusiness.pt)"

#. model_terms: res.config.settings / field:saft_tenant_id / help
msgid "Identificador único da vossa licença. Obtido no portal D&C."
msgstr "Unique identifier for your licence. Obtained from the D&C portal."

#. model_terms: res.config.settings / field:saft_api_key / help
msgid "Chave secreta da API. Trate como password – não partilhe."
msgstr "Secret API key. Treat as a password – do not share."

#. model_terms: res.config.settings / field:saft_default_tier / string
msgid "Tier Padrão"
msgstr "Default Tier"

#. model_terms: res.config.settings / field:saft_default_tier / help
msgid "Tier a usar quando o upload não especifica explicitamente."
msgstr "Tier to use when upload does not explicitly specify one."

#. res_config_settings.py: action_test — warning message
msgid "Preencha a URL da API antes de testar."
msgstr "Please fill in the API URL before testing."

# ---------------------------------------------------------------------------
# Model: saft.upload.wizard
# ---------------------------------------------------------------------------

#. model: saft.upload.wizard / _description
msgid "Upload e Análise de SAF-T"
msgstr "SAF-T Upload & Analysis"

#. model_terms: saft.upload.wizard / field:saft_file / string
msgid "Ficheiro SAF-T (XML)"
msgstr "SAF-T File (XML)"

#. model_terms: saft.upload.wizard / field:saft_file / help
msgid "Exporte o ficheiro SAF-T do vosso software de contabilidade (extensão .xml)."
msgstr "Export the SAF-T file from your accounting software (.xml extension)."

#. model_terms: saft.upload.wizard / field:file_name / string
msgid "Nome do ficheiro"
msgstr "File name"

#. model_terms: saft.upload.wizard / field:requested_tier / string
msgid "Tier Solicitado"
msgstr "Requested Tier"

#. model_terms: saft.upload.wizard / field:requested_tier / help
msgid "Deixe em branco para usar o tier da subscrição contratada."
msgstr "Leave blank to use the contracted subscription tier."

#. saft_upload_wizard.py: _get_api_credentials — UserError
msgid ""
"O módulo Python \"requests\" não está instalado no servidor Odoo."
msgstr ""
"The Python \"requests\" module is not installed on the Odoo server."

#. saft_upload_wizard.py: _get_api_credentials — UserError (multi-line)
msgid ""
"A API SAF-T não está configurada.\n"
"Vá a Configurações > SAF-T Analyser e preencha URL, Tenant ID e API Key."
msgstr ""
"The SAF-T API is not configured.\n"
"Go to Settings > SAF-T Analyser and fill in the URL, Tenant ID and API Key."

#. saft_upload_wizard.py: action_analyse — ConnectionError
msgid ""
"Não foi possível conectar à API SAF-T.\n"
"Verifique a URL em Configurações e a conectividade de rede."
msgstr ""
"Could not connect to the SAF-T API.\n"
"Check the URL in Settings and your network connectivity."

#. saft_upload_wizard.py: action_analyse — Timeout
msgid ""
"Timeout ao processar o ficheiro SAF-T.\n"
"Tente com um ficheiro mais pequeno ou contacte o suporte."
msgstr ""
"Timeout while processing the SAF-T file.\n"
"Try with a smaller file or contact support."

#. saft_upload_wizard.py: action_analyse — HTTPError on submit (format string)
msgid "Erro da API SAF-T ao submeter: %s"
msgstr "SAF-T API error on submit: %s"

#. saft_upload_wizard.py: action_analyse — missing job_id
msgid "A API não devolveu um job_id válido."
msgstr "The API did not return a valid job_id."

#. saft_upload_wizard.py: action_analyse — KPI HTTPError (format string)
msgid "Erro ao obter KPIs: %s"
msgstr "Error fetching KPIs: %s"

#. saft_upload_wizard.py: action_analyse — KPI unexpected error (format string)
msgid "Erro inesperado ao obter KPIs: %s"
msgstr "Unexpected error fetching KPIs: %s"

