# ---------------------------------------------------------------------------
# Views — saft_upload_wizard_views.xml
# ---------------------------------------------------------------------------

#. saft_upload_wizard_views.xml: form string
msgid "Analisar SAF-T"
msgstr "Analyse SAF-T"

#. saft_upload_wizard_views.xml: h2 heading
msgid "🕵️ Analisar Ficheiro SAF-T"
msgstr "🕵️ Analyse SAF-T File"

#. saft_upload_wizard_views.xml: description paragraph
msgid ""
"Carregue o ficheiro SAF-T exportado do vosso software de contabilidade.\n"
"                        O motor D&C irá processar e devolver KPIs e relatório completo."
msgstr ""
"Upload the SAF-T file exported from your accounting software.\n"
"                        The D&C engine will process it and return KPIs and a full report."

#. saft_upload_wizard_views.xml: tier field string override
msgid "Tier de Análise"
msgstr "Analysis Tier"

#. saft_upload_wizard_views.xml: tier field help override
msgid "Deixe em branco para usar o tier configurado na subscrição."
msgstr "Leave blank to use the tier configured in the subscription."

#. saft_upload_wizard_views.xml: privacy notice label
msgid "ℹ️ Nota de privacidade:"
msgstr "ℹ️ Privacy notice:"

#. saft_upload_wizard_views.xml: privacy notice body
msgid ""
"O ficheiro é processado de forma segura nos servidores D&C.\n"
"                        Não é guardada nenhuma cópia do ficheiro original."
msgstr ""
"The file is processed securely on D&C servers.\n"
"                        No copy of the original file is stored."

#. saft_upload_wizard_views.xml: analyse button
msgid "🚀 Analisar SAF-T"
msgstr "🚀 Analyse SAF-T"

#. saft_upload_wizard_views.xml: cancel button
msgid "Cancelar"
msgstr "Cancel"

#. saft_upload_wizard_views.xml: action name
msgid "Nova Análise SAF-T"
msgstr "New SAF-T Analysis"

